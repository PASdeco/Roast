# Roast My X — environment template.
# Copy to .env and fill in. NEVER commit the real .env.
# NOTE: every wallet address / private key used in this project must be
# personally confirmed by the owner before being placed here.

# ---- GenLayer connection -------------------------------------------------
# Network for contract deployment + backend-funded execution:
# studionet | testnet_asimov | testnet_bradbury | localnet
GENLAYER_NETWORK=studionet
GENLAYER_RPC=https://studio.genlayer.com/api

# Backend-funded wallet that submits roast evaluations (server-side ONLY).
# Generate a dedicated wallet; never reuse a personal one. Requires funds.
BACKEND_PRIVATE_KEY=

# ---- Deployed contracts (filled after deployment) ------------------------
ROAST_PAYMENTS_CONTRACT_ADDRESS=
ROAST_JURY_CONTRACT_ADDRESS=

# ---- Treasury ------------------------------------------------------------
# Owner/treasury receives withdrawn GEN from RoastPayments. The payments
# contract owner is whichever wallet deploys it — use the backend wallet or
# a dedicated treasury wallet, confirmed with the project owner first.
TREASURY_WALLET_ADDRESS=

# ---- Credit packages (GEN wei per package; 1 GEN = 10^18) ----------------
CREDIT_PACKAGES_JSON={"packages":[{"id":"starter","gen_wei":"1000000000000000000","credits":10},{"id":"double","gen_wei":"2000000000000000000","credits":20},{"id":"jury","gen_wei":"5000000000000000000","credits":50}],"min_gen_wei":"1000000000000000000"}

# Roast pricing
ROAST_COST_CREDITS=5

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local dev (SQLite):
DATABASE_PATH=./data/roast.db
# Production (Vercel + Neon Postgres) — set DATABASE_URL in Vercel env:
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
